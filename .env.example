# Public (safe to expose to the browser; RLS allows anon SELECT only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional MapLibre vector style overrides. Defaults: Bright (light), Fiord (dark).
# VITE_MAP_LIGHT_STYLE_URL=https://tiles.openfreemap.org/styles/bright
# VITE_MAP_DARK_STYLE_URL=https://tiles.openfreemap.org/styles/fiord
# VITE_MAP_STYLE_URL= # fallback override for both themes

# Public URL of the photo bucket (R2 custom domain or r2.dev URL), no trailing slash. Unset: no photos shown.
# VITE_PHOTOS_URL=https://photos.grub.cam

# Server-side only: used by `npm run ingest` and `ingest:manual`. NEVER commit or expose to the browser.
SUPABASE_SECRET_KEY=
# Database password for `supabase link` / `supabase db push`
SUPABASE_DB_PASSWORD=
# Cloudflare R2, for `npm run ingest:photo` (an API token with Object Read & Write on the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
