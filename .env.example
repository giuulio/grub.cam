# Public (safe to expose to the browser; RLS allows anon SELECT only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Apple's maps (MapKit JS): a token from the Apple Developer account (Services → Maps → Configure → Tokens), type
# MapKit JS, restricted to the site's domains. Apple makes one token per domain and matches it exactly (grub.cam doesn't
# cover www.grub.cam or localhost): list them comma-separated and each page uses its own domain's. Without one,
# or if Apple refuses it, maps are OpenFreeMap's. For `npm run dev`, a second token (Restriction Type: None) in
# .env.development.local, which Vite reads only in development.
# VITE_MAPKIT_TOKEN=

# Optional MapLibre vector style overrides (the OpenFreeMap fallback). Defaults: Bright (light), Fiord (dark).
# VITE_MAP_LIGHT_STYLE_URL=https://tiles.openfreemap.org/styles/bright
# VITE_MAP_DARK_STYLE_URL=https://tiles.openfreemap.org/styles/fiord
# VITE_MAP_STYLE_URL= # fallback override for both themes

# Where photo files are served, no trailing slash. Default: the site's own /photos (public/photos in the repo).
# VITE_PHOTOS_URL=https://photos.example.com

# Server-side only: used by `npm run ingest` and `ingest:manual`. NEVER commit or expose to the browser.
SUPABASE_SECRET_KEY=
# Database password for `supabase link` / `supabase db push`
SUPABASE_DB_PASSWORD=

# Switching on Microsoft sign-in, once: `npm run auth:azure` (see README, Switching on sending in). Never committed.
# SUPABASE_ACCESS_TOKEN=   # a personal access token, supabase.com/dashboard/account/tokens
# AZURE_CLIENT_ID=         # the app registration's Application (client) ID
# AZURE_CLIENT_SECRET=     # a client secret's Value

# The submit function's model key lives in Supabase's secrets (`supabase secrets set OPENAI_API_KEY=…`), not here;
# `npm run models:compare` reads it from here.
# OPENAI_API_KEY=
