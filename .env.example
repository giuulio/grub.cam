# Database password for `supabase link` / `supabase db push` (server-side only)
SUPABASE_DB_PASSWORD=

# Public (safe to expose to the browser; RLS allows anon SELECT only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only: used by `npm run seed`. NEVER commit or expose to the browser.
SUPABASE_SECRET_KEY=
